INCLUDE: prelude.ch

TEST: If without else true
INPUT: if 1 { 10 }
EXPECT: 10

TEST: If without else false
INPUT: if 0 { 10 }
EXPECT: ()

TEST: Else if selects branch
INPUT: if 0 { 1 } else if 1 { 2 } else { 3 }
EXPECT: 2

TEST: Else if without else falls back to empty
INPUT: if 0 { 1 } else if 0 { 2 }
EXPECT: ()

TEST: Else if with else
INPUT: if 0 { 1 } else if 0 { 2 } else { 3 }
EXPECT: 3
