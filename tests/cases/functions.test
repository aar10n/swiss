INCLUDE: prelude.ch

TEST: List length
INPUT: len([1, 2, 3])
EXPECT: 3

TEST: Tuple length
INPUT: len((1, 2, 3))
EXPECT: 3

TEST: String length
INPUT: len("hello")
EXPECT: 5

TEST: Invalid length
INPUT: len(5)
EXPECT_ERROR: Exception: cannot get length of type: int

TEST: Reverse list
INPUT: reverse([1, 2, 3])
EXPECT: [3, 2, 1]

TEST: Reverse tuple
INPUT: reverse((1, 2, 3))
EXPECT: (3, 2, 1)

TEST: Reverse string
INPUT: reverse("abc")
EXPECT: "cba"

TEST: Sum zero
INPUT: sum()
EXPECT: 0

TEST: Sum one
INPUT: sum(1)
EXPECT: 1

TEST: Sum many
INPUT: sum(1, 2, 3, 4, 5)
EXPECT: 15

TEST: Sum splat
INPUT: sum([1, 2, 3]...)
EXPECT: 6

TEST: Min multiple
INPUT: min(5, 2, 8, 1, 9)
EXPECT: 1

TEST: Max multiple
INPUT: max(5, 2, 8, 1, 9)
EXPECT: 9

TEST: Return type annotation converts to unit
INPUT: {
  fn asin_wrapped(x: num): [rad] { builtin::asin(x) }
  asin_wrapped(0.5)
}
EXPECT: 0.5235987755982989 rad

TEST: Return type annotation converts units
INPUT: {
  fn to_deg(x: [rad]): [deg] { x }
  to_deg(pi rad)
}
EXPECT: 180 deg

TEST: Return type annotation mismatch error
INPUT: {
  fn bad(): num { "nope" }
  bad()
}
EXPECT_ERROR: TypeError: expected 'num', found 'str'

TEST: Param annotation attaches unit
INPUT: {
  fn keep_rad(x: [rad]) { x }
  keep_rad(0.5)
}
EXPECT: 0.5 rad

TEST: Param annotation converts unit
INPUT: {
  fn keep_rad(x: [rad]) { x }
  keep_rad(180deg)
}
EXPECT: 3.141592653589793 rad
