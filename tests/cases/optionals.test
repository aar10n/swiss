INCLUDE: prelude.ch

SETUP: {
  fn func_with_optional(x: any?) {
    if x {
      x
    } else {
      42
    }
  }

  fn positional_args(a: any, b: any?, c: any?) {
    (a, b, c)
  }

  fn pair(a: any, b: any) {
    (a, b)
  }
}

TEST: Optional omitted
INPUT: func_with_optional()
EXPECT: 42

TEST: Optional explicit empty
INPUT: func_with_optional(())
EXPECT: 42

TEST: Optional positional
INPUT: func_with_optional(10)
EXPECT: 10

TEST: Optional positional defaults
INPUT: positional_args(1)
EXPECT: (1, (), ())

TEST: Optional positional provided
INPUT: positional_args(1, 2)
EXPECT: (1, 2, ())

TEST: Optional positional all
INPUT: positional_args(1, 2, 3)
EXPECT: (1, 2, 3)

TEST: Named optional mix
INPUT: positional_args(1, c = 3)
EXPECT: (1, (), 3)

TEST: Named optional positional and name
INPUT: positional_args(1, 2, c = 3)
EXPECT: (1, 2, 3)

TEST: Named required out of order
INPUT: positional_args(c = 3, a = 1)
EXPECT: (1, (), 3)

TEST: Named args without optionals
INPUT: pair(b = 2, a = 1)
EXPECT: (1, 2)

TEST: Invalid named argument
INPUT: positional_args(invalid = 1)
EXPECT_ERROR: TypeError: unknown parameter: invalid

TEST: Positional after named
INPUT: positional_args(c = 3, 1)
EXPECT_ERROR: TypeError: positional argument after named argument

TEST: Required after optional error
INPUT: fn no_required_after_optional(x: any?, y: any) { x }
EXPECT_ERROR: TypeError: required parameter cannot follow optional parameter

TEST: Optional after variadic error
INPUT: fn no_optional_after_varargs(rest..., y: any?) { y }
EXPECT_ERROR: TypeError: variadic parameter must be last
