INCLUDE: prelude.ch

TEST: Encode object
INPUT: json_encode({"a": 1, "b": [true, "x"]})
EXPECT: "{\"a\":1,\"b\":[true,\"x\"]}"

TEST: Decode object
INPUT: json_decode("{\"a\":1,\"b\":[true,false]}")
EXPECT: {"a": 1, "b": [true, false]}

TEST: Round trip list
INPUT: json_decode(json_encode([1, 2, 3]))
EXPECT: [1, 2, 3]

TEST: Encode dimensioned quantity error
INPUT: json_encode(1 m)
EXPECT_ERROR: Exception: cannot encode dimensioned quantity to json
