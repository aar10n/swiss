WORKDIR: ${FILE_DIR}/../testdata/

INCLUDE: prelude.ch
SWISSPATH: ${FILE_DIR}/../testdata:${FILE_DIR}/../..

TEST: module declaration scopes items
INPUT: {
  3
}
EXPECT: 3

TEST: module can access parent declarations
INPUT: {
  const base_val = 10
  module math {
    const twice = base_val * 2
  }
  math::twice
}
EXPECT: 20

TEST: import submodule exposes alias
INPUT: {
  import my_module::io
  io::answer
}
EXPECT: 8

TEST: module value typeof
INPUT: {
  module io {
    const X = 123
  }
  builtin::typeof(io)
}
EXPECT: "module"

TEST: submodule value typeof
INPUT: {
  module io {
    module nested {
      const X = 123
    }
  }
  builtin::typeof(io::nested)
}
EXPECT: "module"

TEST: dir lists module names
INPUT: {
  module io {
    const X = 123
    fn f() { X }
    module nested {
      const Y = 1
    }
  }
  builtin::dir(io)
}
EXPECT: ["X", "f", "nested"]
