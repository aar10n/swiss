INCLUDE: prelude.ch
WORKDIR: ${TEST_TMP}
SWISSPATH: ${FILE_DIR}/../

SETUP: {
  import env
  env::unsetenv("SWISS_TEST_ENV_VAR")
}

TEST: getenv missing returns empty
INPUT: env::getenv("SWISS_TEST_ENV_VAR")
EXPECT: ()

TEST: setenv and getenv
INPUT: {
  env::setenv("SWISS_TEST_ENV_VAR", "ok")
  env::getenv("SWISS_TEST_ENV_VAR")
}
EXPECT: "ok"

TEST: unsetenv removes value
INPUT: {
  env::setenv("SWISS_TEST_ENV_VAR", "gone")
  env::unsetenv("SWISS_TEST_ENV_VAR")
  env::getenv("SWISS_TEST_ENV_VAR")
}
EXPECT: ()

TEST: has reports presence
INPUT: {
  env::unsetenv("SWISS_TEST_ENV_VAR")
  missing = env::has("SWISS_TEST_ENV_VAR")
  env::setenv("SWISS_TEST_ENV_VAR", "1")
  present = env::has("SWISS_TEST_ENV_VAR")
  [missing, present]
}
EXPECT: [false, true]
